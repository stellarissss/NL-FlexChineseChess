# 复制为 .env 后由 start.sh 自动加载；.env 已被 .gitignore 排除，绝不入库。
# 方式一（推荐）：直接用环境变量提供密钥，无需 config.json
DEEPSEEK_API_KEY=sk-在这里填入你的DeepSeek密钥

# 可选：模型 / 接口地址（默认值如下，通常无需修改）
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 可选：思考档位。off 关闭；low/high/max 逐级增强语义理解（首轮默认 low）
# DEEPSEEK_AGENT_THINK=off
# DEEPSEEK_FIRST_TURN_THINK=low

# 服务端口与监听地址（默认 9401 / 0.0.0.0）
CHESS_PORT=9401
CHESS_HOST=0.0.0.0

# 可选：运行时目录（默认 ./runtime），多实例部署时为每个实例指定独立目录
# CHESS_RUNTIME_DIR=./runtime
